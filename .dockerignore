# 构建上下文排除项：减小上下文体积、加快构建、避免泄漏本地数据
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 本地数据与日志绝不进镜像
data/
logs/
*.db
*.db-wal
*.db-shm
*.log

# 前端依赖与产物由构建阶段自己生成，无需拷入上下文
web/node_modules/
web/dist/
web/.vite/

# 本地配置
.env
.env.*
!.env.example

# 编辑器与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db
