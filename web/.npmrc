# 本机 npm 官方源不可达（超时），必须走国内镜像。
# 固化在这里而不是靠全局配置，换机器/换 CI 才不会装不上。
registry=https://registry.npmmirror.com
strict-ssl=true

# esbuild 二进制走镜像，否则下载超时。
# 注意：允许哪些依赖执行安装脚本，配置在 package.json 的 pnpm.onlyBuiltDependencies
# （pnpm 11 不再从 .npmrc 读该键）。
esbuild_binary_host_mirror=https://registry.npmmirror.com/-/binary/esbuild
