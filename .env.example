# AIgoTutor 环境变量示例
#
# 用法：cp .env.example .env 然后按需修改。
# 所有变量都有合理默认值，因此最小可运行配置只需改 SECRET_KEY。

# ---------------------------------------------------------------- 基础
# 必改：用于签发登录 token，泄漏等于任何人都能伪造身份
AIGOTUTOR_SECRET=please-change-this-to-a-long-random-string

# access token 短命（2 小时），refresh token 长命（30 天）
AIGOTUTOR_ACCESS_TTL=7200
AIGOTUTOR_REFRESH_TTL=2592000

# 首个注册用户是否自动成为管理员（首次部署省去手工提权）
AIGOTUTOR_FIRST_ADMIN=1

# ---------------------------------------------------------------- 数据库
# SQLite 文件路径；容器内保持默认即可
AIGOTUTOR_DB=/app/data/aigotutor.db

# ---------------------------------------------------------------- 模型
# mock=离线确定性输出（无需 Key）；openai|anthropic|gemini=真实模型
AIGOTUTOR_PROVIDER=mock
AIGOTUTOR_MODEL=mock-1
# 真实模型示例（用户也可在前端「设置」页按用户配置）
# AIGOTUTOR_PROVIDER=openai
# AIGOTUTOR_MODEL=gpt-4o-mini
# AIGOTUTOR_API_KEY=sk-xxxx
# AIGOTUTOR_BASE_URL=https://api.openai.com/v1
AIGOTUTOR_LLM_TIMEOUT=60
AIGOTUTOR_LLM_RETRY=2

# ------------------------------------------------------------ 判题沙箱
# subprocess=本机执行（隔离弱，仅内网/开发）；docker=容器隔离（生产必选）；none=关闭
AIGOTUTOR_JUDGE_BACKEND=subprocess
AIGOTUTOR_JUDGE_TIMEOUT=10
AIGOTUTOR_JUDGE_MEMORY=256
AIGOTUTOR_JUDGE_IMAGE=python:3.13-slim
AIGOTUTOR_JUDGE_OUTPUT_LIMIT=65536

# ---------------------------------------------------------------- 防护
AIGOTUTOR_RATE_LIMIT=1
AIGOTUTOR_RATE_LIMIT_RPM=120
AIGOTUTOR_MAX_REQUEST_BYTES=2097152
# 同用户同题同代码的去重窗口（秒）；0 表示关闭
AIGOTUTOR_DEDUP_WINDOW=30
# Agent 链路并发上限；超出排队而非拒绝
AIGOTUTOR_MAX_PIPELINES=8

# ------------------------------------------------------------ 可观测性
# 1=JSON 日志（生产，便于采集）；0=人类可读（开发）
AIGOTUTOR_LOG_JSON=1
AIGOTUTOR_LOG_LEVEL=INFO

# ---------------------------------------------------------------- 前端
AIGOTUTOR_SERVE_WEB=1
# AIGOTUTOR_WEB_DIST=/app/web/dist
